{
  "name": "montreal-api",
  "private": true,
  "version": "0.1.0",
  "description": "API da loja Montreal Moda e Casa (Node.js + Fastify + PostgreSQL)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch-path=src src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:generate": "prisma generate",
    "admin:grant": "node --env-file-if-exists=.env scripts/setAdmin.js",
    "admin:revoke": "node --env-file-if-exists=.env scripts/setAdmin.js --revoke",
    "prod:seed": "node --env-file=.env.production prisma/seed.js",
    "prod:admin:grant": "node --env-file=.env.production scripts/setAdmin.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/multipart": "10.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "prisma": "7.10.1"
  }
}
