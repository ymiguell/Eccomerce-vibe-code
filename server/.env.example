# Copie este arquivo para .env (o .env não vai para o Git).

# Banco local do docker-compose.yml. Em produção, use a URL do provedor (ex.: Neon).
DATABASE_URL="postgresql://montreal:montreal@localhost:5432/montreal?schema=public"

# Porta da API
PORT=3333

# Endereços do site que podem chamar a API, separados por vírgula
CORS_ORIGINS="http://localhost:5173"

# Endereço desta API, usado no link das fotos enviadas pelo painel
PUBLIC_URL="http://localhost:3333"

# Serviço de imagens (na hospedagem). Vazio = fotos do painel na pasta server/uploads/
# Formato: cloudinary://<api_key>:<api_secret>@<cloud_name> (painel do Cloudinary → API Keys)
CLOUDINARY_URL=""

# Serviço de e-mail (na hospedagem). Vazio = e-mails aparecem no terminal da API
# Chave em: painel do Brevo → SMTP & API → API Keys
BREVO_API_KEY=""
# Quem envia os e-mails (precisa estar verificado no Brevo → Senders)
EMAIL_FROM="montrealmoda1@gmail.com"
EMAIL_FROM_NAME="Montreal Moda e Casa"

# Frete (na hospedagem). Vazio = tabela da loja (R$ 19,90 e prazo por região)
# Token em: Melhor Envio → Integrações → Permissões de acesso → Gerar token (permissão shipping-calculate)
MELHOR_ENVIO_TOKEN=""
# true = ambiente de testes do Melhor Envio (sandbox.melhorenvio.com.br, conta e token de lá)
MELHOR_ENVIO_SANDBOX=false
# Serviços oferecidos (ids do Melhor Envio). Vazio = Correios PAC (1) e SEDEX (2), Jadlog .Package (3) e .Com (4), J&T (33)
MELHOR_ENVIO_SERVICES=""
# CEP de onde a loja posta os pacotes
STORE_CEP="13844-110"

# Endereço do site, usado nos links dos e-mails (ex.: "esqueci minha senha")
SITE_URL="http://localhost:5173"

# true quando a API roda atrás de um proxy (ex.: Render); localmente, deixe false
TRUST_PROXY=false
